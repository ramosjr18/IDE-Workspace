{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat de agentes",
  "version": "1.0.0",
  "identifier": "com.auriatech.agentchat",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chat de agentes",
        "width": 1400,
        "height": 880,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTQ5RjVEOTZBRTFFQkIKUldTN0hxNldYWi9rVmRVWG42RHZwd1RGWDVJQkorWHVhdGlUc2Q3czhydDdiSm9XdG8rdFN6aTEK",
      "endpoints": [
        "https://github.com/ramosjr18/IDE-Workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
