# Copia este archivo como .env y cambia las claves (CAMBIAR): .env no va a git.
DEBUG=0
SECRET_KEY=CAMBIAR
WEB_URL=http://localhost:8100
APP_BASE_URL=http://localhost:8100
CORS_ALLOWED_ORIGINS=http://localhost:8100,tauri://localhost,http://tauri.localhost
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=600/minute

POSTGRES_USER=plane
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_HOST=db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:CAMBIAR@db:5432/plane

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/

RABBITMQ_HOST=mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CAMBIAR
RABBITMQ_VHOST=plane

USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=plane
AWS_SECRET_ACCESS_KEY=CAMBIAR
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

LIVE_SERVER_SECRET_KEY=CAMBIAR
HARD_DELETE_AFTER_DAYS=60
