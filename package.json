{
  "name": "ide-workspace-chat",
  "version": "1.0.0",
  "private": true,
  "description": "App de escritorio para chatear con agentes CLI (Claude, Codex, OpenCode, Antigravity, Gemini)",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vendor": "node -e \"const f=require('fs'),p=require('path');f.mkdirSync('ui/vendor',{recursive:true});for(const [a,b] of [['@xterm/xterm/lib/xterm.js','xterm.js'],['@xterm/xterm/css/xterm.css','xterm.css'],['@xterm/addon-fit/lib/addon-fit.js','addon-fit.js']])f.copyFileSync(require.resolve(a),'ui/vendor/'+b);f.rmSync('ui/vendor/monaco',{recursive:true,force:true});f.cpSync(p.join(p.dirname(require.resolve('monaco-editor/package.json')),'min','vs'),'ui/vendor/monaco/vs',{recursive:true})\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "monaco-editor": "^0.52.2"
  }
}
