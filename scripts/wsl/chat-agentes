#!/bin/bash
# Abre la versión estable de Chat de agentes.
# Solo cambia si se instala otra versión; los cambios en el repo no le afectan.
# Se instala en /usr/local/bin/chat-agentes (ver docs/version-estable-wsl.md).
cd ~
export WEBKIT_DISABLE_DMABUF_RENDERER=1
# Seguir el tema de Windows: GTK (y con él prefers-color-scheme de la app) no lo ve por sí solo.
reg=/mnt/c/Windows/System32/reg.exe
if [ -x "$reg" ] && "$reg" query 'HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' /v AppsUseLightTheme 2>/dev/null | grep -q '0x0'; then
  export GTK_THEME=Adwaita:dark
fi
# En WSLg, GTK usa la disposición de GNOME («appmenu:close»): solo el botón de cerrar. Se añaden minimizar y maximizar.
if command -v gsettings >/dev/null && [ "$(gsettings get org.gnome.desktop.wm.preferences button-layout 2>/dev/null)" = "'appmenu:close'" ]; then
  gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' 2>/dev/null
fi
# Versiones: la que instala la propia app al actualizarse (~/.local/share/chat-agentes, docs/releases.md)
# y la compilada desde el repo con instalar-estable.sh (/opt/chat-agentes). Se abre la instalada más tarde.
app=/opt/chat-agentes/actual/chat-agentes
propia="${XDG_DATA_HOME:-$HOME/.local/share}/chat-agentes/actual"
if [ -x "$propia/chat-agentes" ] && { [ ! -x "$app" ] || [ "$propia/VERSION" -nt /opt/chat-agentes/actual/VERSION ]; }; then
  app="$propia/chat-agentes"
fi
exec "$app" "$@"
